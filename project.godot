; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Koki Dungeon"
run/main_scene="res://levels/test_kitchen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
Game="*res://autoload/game.gd"
Net="*res://autoload/net.gd"
Save="*res://autoload/save.gd"
Audio="*res://autoload/audio.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/size/min_size=Vector2i(960, 540)

